  "typedErrorCodes": [
    { "code": "invalid-request", "category": "validation", "retryable": false },
    { "code": "unauthorized", "category": "authorization", "retryable": false },
    { "code": "forbidden", "category": "authorization", "retryable": false },
    { "code": "not-ready", "category": "readiness", "retryable": true },
    { "code": "not-found", "category": "not-found", "retryable": false },
    { "code": "conflict", "category": "conflict", "retryable": true },
    { "code": "revision-conflict", "category": "conflict", "retryable": true },
    { "code": "unsupported-schema", "category": "schema", "retryable": false },
    { "code": "corrupt", "category": "storage", "retryable": false },
    { "code": "quota", "category": "capacity", "retryable": false },
    { "code": "timeout", "category": "timeout", "retryable": true },
    { "code": "upstream", "category": "upstream", "retryable": true },
    { "code": "commit-unknown", "category": "recovery", "retryable": true },
    { "code": "manual-recovery", "category": "recovery", "retryable": false },
    { "code": "unsupported-operation", "category": "unsupported", "retryable": false },
    { "code": "path-not-allowed", "category": "authorization", "retryable": false },
    { "code": "idempotency-required", "category": "validation", "retryable": false },
    { "code": "revision-required", "category": "validation", "retryable": false }
