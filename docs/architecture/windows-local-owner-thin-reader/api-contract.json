      "mutationRequirements": { "expectedRevision": "required when current domain revision exists", "idempotencyKey": "required for start/cancel/retry/config/index commands" },
      "revisionSource": "jobs/history envelope revisions and DurableJsonRepository known revisions",
      "backupAdapter": "WorkflowBackupAdapter",
      "recoveryHandler": "workflow JSON recovery/ProcessSupervisor handler",
      "authorityReadyInThisMilestone": false
    }
  ],
