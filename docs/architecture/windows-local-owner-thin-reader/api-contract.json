      "queryOperations": ["marks", "activity", "revision", "receipt", "conflict"],
      "commandOperations": ["marks-commit", "activity-append", "receipt-query"],
      "capabilities": ["marks-activity.query", "marks-activity.commit", "marks-activity.receipt"],
      "mutationRequirements": { "expectedRevision": "required for marks/activity CAS", "idempotencyKey": "required for activity and retryable marks commands" },
      "revisionSource": "per-job marks/activity envelope revision and commit journal",
