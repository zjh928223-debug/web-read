      "futureOwnerFacade": "windowsHost.annotationOwner",
      "canonicalRecordsRef": "domain-inventory.json#/domains/annotation",
      "queryOperations": ["bundle", "scope", "generated", "status", "corrupt-evidence", "storage-mode"],
      "commandOperations": ["bundle-commit", "lightweight-import", "lightweight-export", "backfill-result-import", "receipt-query"],
      "capabilities": ["annotation.query", "annotation.commit", "annotation.import", "annotation.export", "annotation.receipt"],
