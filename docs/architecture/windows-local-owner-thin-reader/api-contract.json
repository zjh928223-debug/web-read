      "capabilities": ["vocabulary-srs.query", "vocabulary-srs.entry-command", "vocabulary-srs.review-command", "vocabulary-srs.learning-command", "vocabulary-srs.receipt"],
      "mutationRequirements": { "expectedRevision": "required for mutable row/UoW command", "idempotencyKey": "required for review, acquisition, learning-event, and report commands" },
      "revisionSource": "vocabulary revision watermark plus repository/UoW CAS",
      "backupAdapter": "IndexedDB vocabulary-srs prefix adapter",
      "recoveryHandler": "vocabulary quarantine/revision-watermark recovery handler, future host-owned",
      "authorityReadyInThisMilestone": false
    },
    {
      "domain": "passage-preview",
