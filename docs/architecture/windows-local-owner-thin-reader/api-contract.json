{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "change": "windows-local-owner-thin-reader",
  "artifactKind": "versioned-typed-windows-thin-reader-api-contract",
  "contractId": "windows-thin-reader-api",
  "contractVersion": "windows-thin-reader-api.v1",
  "implementationStatus": "contract-only",
  "routePolicy": "Semantic operation names are frozen; concrete HTTP route paths are intentionally not frozen by task 2.1",
  "transport": {
    "kind": "http-json-loopback",
    "bindAddress": "127.0.0.1",
    "portSource": "config/runtime.optimization.json",
    "optimizationFrontendPort": 5184,
    "optimizationBackendPort": 8776,
    "nonLoopbackAllowed": false,
    "remoteTransport": false,
    "corsIsAuthentication": false,
    "authorizationBeforePathOrCredentialAccess": true
  },
  "identityAndMutationRules": {
    "requestId": {
      "type": "string",
      "required": true,
      "meaning": "Unique identity for one transport request",
      "maxLength": 128,
      "format": "opaque-safe-token"
    },
    "correlationId": {
      "type": "string",
      "required": true,
      "meaning": "Stable identity across a UI intent, retries, owner work, and receipt lookup",
      "maxLength": 128,
      "format": "opaque-safe-token"
    },
    "expectedRevision": {
      "type": "integer-or-string-or-null",
      "requiredWhen": "mutable domain command, except an explicitly registered bootstrap prepare",
      "meaning": "The caller's authoritative base revision; owner rejects stale values and never silently last-writes-wins",
      "allowed": ["non-negative integer", "non-empty revision token", null]
    },
    "idempotencyKey": {
      "type": "string-or-null",
      "requiredWhen": "every mutation command and every retry that could repeat a side effect",
      "meaning": "Stable mutation identity; same key plus same request fingerprint returns the same receipt/effect",
      "maxLength": 256,
      "allowed": ["non-empty safe string", null]
    },
    "commitStatus": {
      "type": "enum",
      "values": ["not-applicable", "pending", "committed", "rejected", "conflict", "commit-unknown", "not-ready", "manual-recovery"],
      "meaning": "Durability status, never inferred from HTTP transport success"
    },
    "receipt": {
      "requiredWhen": "mutation response with committed, rejected, conflict, or commit-unknown status",
      "meaning": "Authoritative owner evidence or an explicit receipt lookup handle",
      "queryRule": "commit-unknown remains unresolved until receipt query or authoritative revision inspection"
    }
  },
  "requestEnvelopeSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["contractVersion", "requestId", "correlationId", "kind", "domain", "operation", "payload"],
    "properties": {
      "contractVersion": { "const": "windows-thin-reader-api.v1" },
      "requestId": { "$ref": "#/$defs/safeIdentity" },
      "correlationId": { "$ref": "#/$defs/safeIdentity" },
      "kind": { "enum": ["query", "command", "receipt-query", "capability-query", "backup-query", "backup-command", "media-query"] },
      "domain": { "enum": ["reader-session", "vocabulary-srs", "passage-preview", "annotation", "marks-activity", "workflow", "profile"] },
      "operation": { "$ref": "#/$defs/safeOperation" },
      "expectedRevision": { "$ref": "#/$defs/revisionToken" },
      "idempotencyKey": { "$ref": "#/$defs/idempotencyToken" },
      "capability": { "$ref": "#/$defs/safeOperation" },
      "payload": { "type": "object" }
    }
  },
  "responseEnvelopeSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["contractVersion", "requestId", "correlationId", "domain", "operation", "outcome", "commitStatus", "revision", "receipt", "payload"],
    "properties": {
      "contractVersion": { "const": "windows-thin-reader-api.v1" },
      "requestId": { "$ref": "#/$defs/safeIdentity" },
      "correlationId": { "$ref": "#/$defs/safeIdentity" },
      "domain": { "enum": ["reader-session", "vocabulary-srs", "passage-preview", "annotation", "marks-activity", "workflow", "profile"] },
      "operation": { "$ref": "#/$defs/safeOperation" },
      "outcome": { "enum": ["read", "committed", "rejected", "conflict", "commit-unknown", "not-ready", "manual-recovery"] },
      "commitStatus": { "enum": ["not-applicable", "pending", "committed", "rejected", "conflict", "commit-unknown", "not-ready", "manual-recovery"] },
      "revision": { "$ref": "#/$defs/revisionToken" },
      "receipt": { "oneOf": [{ "$ref": "#/$defs/receipt" }, { "type": "null" }] },
      "capability": { "type": "object" },
      "diagnostic": { "type": "object" },
      "payload": { "type": "object" },
      "error": { "oneOf": [{ "$ref": "#/$defs/typedError" }, { "type": "null" }] }
    }
  },
  "receiptSchema": {
    "$ref": "#/$defs/receipt"
  },
  "typedErrorSchema": {
    "$ref": "#/$defs/typedError"
  },
  "$defs": {
    "safeIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "safeOperation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9.-]{0,95}$"
    },
    "idempotencyToken": {
      "type": ["string", "null"],
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "revisionToken": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "minLength": 1, "maxLength": 128 },
        { "type": "null" }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "contractVersion", "profileId", "instanceId", "requestId", "correlationId", "domain", "operation", "idempotencyKey", "expectedRevision", "requestFingerprint", "commitStatus", "revision", "effectFingerprint", "recordChecksums", "evidenceChecksum", "evidenceSource", "createdAt", "committedAt", "queryOperation"],
      "properties": {
        "receiptId": { "$ref": "#/$defs/safeIdentity" },
        "contractVersion": { "const": "windows-thin-reader-api.v1" },
        "profileId": { "$ref": "#/$defs/safeIdentity" },
        "instanceId": { "$ref": "#/$defs/safeIdentity" },
        "requestId": { "$ref": "#/$defs/safeIdentity" },
        "correlationId": { "$ref": "#/$defs/safeIdentity" },
        "domain": { "enum": ["reader-session", "vocabulary-srs", "passage-preview", "annotation", "marks-activity", "workflow"] },
        "operation": { "$ref": "#/$defs/safeOperation" },
        "idempotencyKey": { "$ref": "#/$defs/idempotencyToken" },
        "expectedRevision": { "$ref": "#/$defs/revisionToken" },
        "requestFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "commitStatus": { "enum": ["pending", "committed", "rejected", "conflict", "commit-unknown", "not-ready", "manual-recovery"] },
        "revision": { "$ref": "#/$defs/revisionToken" },
        "effectFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "recordChecksums": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
        "evidenceChecksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "evidenceSource": { "$ref": "#/$defs/safeIdentity" },
        "createdAt": { "type": "string", "format": "date-time" },
        "committedAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "queryOperation": { "const": "receipt-query" }
      }
    },
    "typedError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code", "category", "message", "retryable", "correlationId", "details"],
      "properties": {
        "type": { "const": "windows-thin-reader-error.v1" },
        "code": { "enum": ["invalid-request", "unauthorized", "forbidden", "not-ready", "not-found", "conflict", "revision-conflict", "unsupported-schema", "corrupt", "quota", "timeout", "upstream", "commit-unknown", "manual-recovery", "unsupported-operation", "path-not-allowed", "idempotency-required", "revision-required"] },
        "category": { "enum": ["validation", "authorization", "readiness", "not-found", "conflict", "schema", "storage", "capacity", "timeout", "upstream", "recovery", "unsupported"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retryable": { "type": "boolean" },
        "correlationId": { "$ref": "#/$defs/safeIdentity" },
        "details": { "type": "object", "additionalProperties": true }
      }
    }
  },
  "outcomeRules": [
    { "outcome": "read", "commitStatus": "not-applicable", "revision": "authoritative revision or null" },
    { "outcome": "committed", "commitStatus": "committed", "revision": "required authoritative domain revision", "receipt": "required" },
    { "outcome": "rejected", "commitStatus": "rejected", "revision": "must not advance", "error": "required" },
    { "outcome": "conflict", "commitStatus": "conflict", "revision": "current authoritative revision when known", "error": "required; stale client must not overwrite" },
    { "outcome": "commit-unknown", "commitStatus": "commit-unknown", "revision": "null or last known revision", "receipt": "lookup handle required; do not replay with a new idempotency key" },
    { "outcome": "not-ready", "commitStatus": "not-ready", "revision": "must not advance", "error": "required; no browser fallback write" },
    { "outcome": "manual-recovery", "commitStatus": "manual-recovery", "revision": "must not advance", "error": "required; readiness remains blocked" }
  ],
  "operationRules": {
    "query": "Queries may omit expectedRevision and idempotencyKey, but must carry requestId/correlationId and return an authoritative revision when one exists",
    "command": "Mutable commands must carry expectedRevision and idempotencyKey according to the registered domain rule; owner returns receipt or typed non-commit result",
    "receiptQuery": "Receipt lookup uses the original idempotencyKey or receiptId with correlationId and never creates a second side effect",
    "backupRestore": "Cross-domain backup/restore is explicit; production restore entry points now require the application profile lease, while the pending journal remains a later task",
    "media": "Media query returns capability/identity/range metadata; complete media bytes are invalid payloads"
  },
  "profileLeaseAndOwnerMode": {
    "schemaVersion": 1,
    "leaseSource": "read-web-production-backup.application-profile-lease",
    "scope": "one isolated Windows application profile",
    "lifetime": "held by the Local App Host lock-holder from startup evidence through stop or startup failure",
    "instanceLifetimeLockTarget": ".read-web-application/instances/<instanceId>",
    "authorityLeaseTarget": ".read-web-application/profiles/<profileId>",
    "authorityLeaseIdentity": "canonical pathMutexKey(authorityLeaseTarget), independent of instanceId",
    "authorityLeaseIsolation": "authorityLeaseTarget must be a strict descendant of the configured optimization application isolation root and must not overlap an instance root",
    "overlapPolicy": "An overlapping replacement may hold its own instance-lifetime lock as standby, but must not acquire or infer the stable profile authority lease",
    "checkpointPath": "owner-mode/checkpoints/<domain>.json",
    "checkpointSchema": "owner-mode-checkpoint.schema.json",
    "checkpointRequiredFields": [
      "profileId",
      "domain",
      "lease",
      "oldWriterBlocked",
      "compatibilityMode",
      "inFlight",
      "repository",
      "authorityMode",
      "checksum"
    ],
    "authoritySwitch": "Only a valid atomic checkpoint may declare host-api=authoritative; missing or invalid checkpoints remain pre-cutover/not-ready",
    "browserBridgeCanonical": false,
    "currentOptimizationMode": "pre-cutover"
  },
  "domainRegistry": [
    {
      "domain": "reader-session",
      "currentImplementation": "browser compatibility persistence; not API-authoritative",
      "futureOwnerFacade": "windowsHost.readerSessionOwner",
      "canonicalRecordsRef": "domain-inventory.json#/domains/reader-session",
      "queryOperations": ["snapshot", "current-revision", "media-identity", "restore-status"],
      "commandOperations": ["prepare", "commit", "restore", "receipt-query"],
      "capabilities": ["reader-session.query", "reader-session.prepare", "reader-session.commit", "reader-session.restore", "reader-session.receipt"],
      "mutationRequirements": { "expectedRevision": "required for commit/restore when a base exists", "idempotencyKey": "required for commit/restore" },
      "revisionSource": "readerSession manifest revision/contentId/checksum",
      "backupAdapter": "read-web-application-backup reader-session adapter",
      "recoveryHandler": "reader-session quarantine and restore handler, future host-owned",
      "authorityReadyInThisMilestone": false
    },
    {
