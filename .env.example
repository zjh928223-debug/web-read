# Optional runtime configuration file. Copy to .env.local and keep secrets out of Git.
# READ_WEB_RUNTIME_CONFIG=E:\read-web-next\config\runtime.next.json
# Optional local overrides for runtime tools (leave empty to use runtime.next.json values).
# WHISPERX_PATH=D:\whisper_env\Scripts\whisperx.exe
# YT_DLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# VITE_LOCAL_SERVICE_BASE_URL=http://127.0.0.1:8766
# READ_WEB_SERVICE_TOKEN=
# VITE_READ_WEB_SERVICE_TOKEN=
# Wordnik is read only by the Windows capability backend. Never expose this in VITE_* variables.
# WORDNIK_API_KEY=
# Optional local guard; Free Basic currently allows 100 calls per hour.
# WORDNIK_LOCAL_HOURLY_BUDGET=100
# ECDICT_ENABLED=false
