# The ECDICT runtime is disabled unless this exact value is "true".
ECDICT_ENABLED=false

# Source files are used only by the offline database build command.
ECDICT_CSV_PATH=data/dictionaries/sources/ecdict.csv
ECDICT_LEMMA_PATH=data/dictionaries/sources/lemma.en.txt

# The runtime opens this SQLite file read-only.
ECDICT_DATABASE_PATH=data/dictionaries/ecdict.sqlite
